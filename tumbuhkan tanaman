<!doctype html>
<html lang="id"><head><meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>Grow a Garden 3D</title>
<link href="https://fonts.googleapis.com/css2?family=Baloo+2:wght@500;700;800&display=swap" rel="stylesheet">
<script src="https://cdnjs.cloudflare.com/ajax/libs/three.js/r128/three.min.js"></script>
<style>
:root{--ink:#3b2a1a;--sky1:#6fcbff;--sky2:#e3f7ff;--panel:#fff6dc;--card:#fff;--gold:#ffc928;--txt:#3b2a1a;--common:#7fd05f;--rare:#4aa8ff;--cool:#b36bff}
@media (prefers-color-scheme:dark){:root:not([data-theme="light"]){--sky1:#1c2a5e;--sky2:#4b3f8f;--panel:#4a3a28;--card:#fff3d6}}
*{box-sizing:border-box}
html,body{margin:0;height:100%;overflow:hidden;background:var(--sky1)}
body{font-family:"Baloo 2","Trebuchet MS",system-ui,sans-serif;font-weight:600;color:var(--txt);background:linear-gradient(var(--sky1),var(--sky2));user-select:none;-webkit-user-select:none}
#cv{position:fixed;inset:0;width:100%;height:100%;display:block;touch-action:none;cursor:grab}
.hud{position:fixed;top:calc(10px + env(safe-area-inset-top,0px));left:calc(10px + env(safe-area-inset-left,0px));display:flex;gap:8px;flex-wrap:wrap;pointer-events:none}
.pill{background:var(--gold);border:3px solid var(--ink);border-radius:999px;padding:1px 14px;font-size:22px;font-weight:800;box-shadow:0 4px 0 var(--ink);color:var(--ink)}
.pill.sm{background:#fff;font-size:18px}
.pill.low{background:#ff9a8a}
#hint{position:fixed;top:calc(64px + env(safe-area-inset-top,0px));left:50%;transform:translateX(-50%);background:rgba(59,42,26,.85);color:#fff;border-radius:16px;padding:4px 16px;font-size:15px;text-align:center;max-width:92vw;transition:opacity .6s;pointer-events:none}
#hint.off{opacity:0}
.btn{font:inherit;font-weight:800;font-size:17px;cursor:pointer;color:var(--ink);background:#7be25a;border:3px solid var(--ink);border-radius:14px;padding:3px 14px;box-shadow:0 4px 0 var(--ink);margin-top:6px}
.btn:active:not(:disabled){transform:translateY(3px);box-shadow:0 1px 0 var(--ink)}
.btn:disabled{background:#d8d2c4;cursor:not-allowed;opacity:.8}
.btn:focus-visible,.chip:focus-visible{outline:4px solid #1b6dff;outline-offset:2px}
.btn.sell{background:var(--gold)}
#act{position:fixed;left:50%;bottom:calc(86px + env(safe-area-inset-bottom,0px));transform:translateX(-50%);font-size:22px;padding:6px 22px;animation:pulse 1s ease-in-out infinite}
@keyframes pulse{50%{transform:translateX(-50%) scale(1.07)}}
#bag{position:fixed;left:50%;bottom:calc(14px + env(safe-area-inset-bottom,0px));transform:translateX(-50%);display:flex;gap:8px;max-width:94vw;overflow-x:auto;padding:4px 6px 8px}
.chip{font:inherit;font-weight:800;font-size:18px;cursor:pointer;background:#fff;color:var(--ink);border:3px solid var(--ink);border-radius:14px;padding:2px 10px;box-shadow:0 4px 0 var(--ink);white-space:nowrap;position:relative}
.chip small{position:absolute;top:-2px;left:4px;font-size:11px;opacity:.6}
.chip.sel{background:#ffe36b;transform:translateY(-5px);box-shadow:0 8px 0 var(--ink)}
#joy{position:fixed;left:calc(18px + env(safe-area-inset-left,0px));bottom:calc(96px + env(safe-area-inset-bottom,0px));width:112px;height:112px;border:4px solid var(--ink);border-radius:50%;background:rgba(255,255,255,.4);touch-action:none;display:none}
#joy i{position:absolute;left:50%;top:50%;width:46px;height:46px;margin:-23px;border-radius:50%;background:var(--gold);border:3px solid var(--ink)}
@media(pointer:coarse){#joy{display:block}}
.modal{position:fixed;inset:0;background:rgba(30,20,10,.45);display:flex;align-items:center;justify-content:center;padding:12px;z-index:5}
.modal[hidden]{display:none}
.panel{position:relative;background:var(--panel);border:4px solid var(--ink);border-radius:26px;box-shadow:0 7px 0 var(--ink);padding:14px;width:min(640px,100%);max-height:88vh;overflow:auto}
.panel h2{margin:0 0 8px;font-size:26px;font-weight:800}
.x{position:absolute;top:8px;right:10px;margin:0;background:#ff7a7a}
.timer{display:flex;align-items:center;gap:10px;margin-bottom:10px}
.bar{flex:1;height:16px;border:3px solid var(--ink);border-radius:99px;background:#fff;overflow:hidden}
.bar i{display:block;height:100%;width:0;background:linear-gradient(#ffe36b,#ffa800)}
#shop{display:grid;grid-template-columns:repeat(auto-fill,minmax(140px,1fr));gap:12px}
.card{position:relative;background:var(--card);border:3px solid var(--ink);border-radius:20px;box-shadow:0 5px 0 var(--ink);padding:26px 8px 10px;text-align:center;color:var(--ink)}
.card .emo{font-size:44px;line-height:1.1}
.card b{display:block;font-size:18px}
.card small{display:block;font-size:13px;opacity:.8;line-height:1.25}
.tag{position:absolute;top:-3px;left:-3px;right:-3px;font-size:12px;font-weight:800;color:#fff;border:3px solid var(--ink);border-radius:17px 17px 12px 12px;text-shadow:0 1px 0 var(--ink)}
.common .tag{background:var(--common)}.rare .tag{background:var(--rare)}.cool .tag{background:var(--cool)}
.secret .tag{background:linear-gradient(90deg,#ff5e8a,#ffc928,#5ee08a,#4aa8ff,#b36bff,#ff5e8a);background-size:200% 100%;animation:rb 3s linear infinite}
.secret{box-shadow:0 5px 0 var(--ink),0 0 18px 4px #ffd36b}.cool{box-shadow:0 5px 0 var(--ink),0 0 14px 2px #c9a0ff}
@keyframes rb{to{background-position:200% 0}}
#toast{position:fixed;left:50%;top:calc(110px + env(safe-area-inset-top,0px));transform:translate(-50%,-20px);background:var(--ink);color:#fff;border-radius:99px;padding:6px 18px;font-weight:700;opacity:0;pointer-events:none;transition:.25s;z-index:9;max-width:90vw;text-align:center}
#toast.on{opacity:1;transform:translate(-50%,0)}
.rows{display:flex;flex-wrap:wrap;gap:8px;margin-bottom:8px}.rows .chip{cursor:default}
@media(prefers-reduced-motion:reduce){*{animation:none!important;transition:none!important}}
</style></head>
<body>
<canvas id="cv" aria-label="Kebun 3D"></canvas>
<div class="hud"><div class="pill">🪙 <span id="coins">0</span></div><div class="pill sm">🧺 <span id="cn">0</span></div><div class="pill sm">🏪 <span id="rt2">2:00</span></div><div class="pill sm">👥 <span id="pc">1/6</span></div><div class="pill sm" id="wp">💧 <span id="wt">50/50 L</span></div><div class="pill sm">🪣 <span id="bk">0/10 L</span></div></div>
<div id="hint">Jalan: WASD / joystick · Tanam di dalam kebun · Air habis? Timba di kolam 💧 lalu tuang ke tangki</div>
<button class="btn" id="act" hidden></button>
<div id="bag"></div>
<div id="joy"><i></i></div>
<div class="modal" id="shopm" hidden><div class="panel"><button class="btn x" data-close aria-label="Tutup">✕</button><h2>🏪 Toko Bibit</h2>
<div class="timer"><span>Restock</span><div class="bar"><i id="rb"></i></div><span id="rt">2:00</span></div><div id="shop"></div></div></div>
<div class="modal" id="sellm" hidden><div class="panel"><button class="btn x" data-close aria-label="Tutup">✕</button><h2>💰 Jual Hasil Panen</h2><div id="crops"></div></div></div>
<div class="modal" id="upm" hidden><div class="panel"><button class="btn x" data-close aria-label="Tutup">✕</button><h2>🛠️ Peralatan</h2><div id="upg"></div></div></div>
<div id="toast" role="status"></div>
<script>
const P=[
{id:'wortel',n:'Wortel',e:'🥕',r:'common',c:10,t:8,s:16},
{id:'stroberi',n:'Stroberi',e:'🍓',r:'common',c:25,t:15,s:45},
{id:'tomat',n:'Tomat',e:'🍅',r:'common',c:40,t:22,s:75},
{id:'jagung',n:'Jagung',e:'🌽',r:'common',c:60,t:30,s:115},
{id:'bawang',n:'Bawang',e:'🧅',r:'common',c:80,t:40,s:150},
{id:'semangka',n:'Semangka',e:'🍉',r:'rare',c:250,t:60,s:520},
{id:'labu',n:'Labu Ajaib',e:'🎃',r:'rare',c:400,t:80,s:880},
{id:'jamur',n:'Jamur Neon',e:'🍄',r:'cool',c:1200,t:120,s:2800},
{id:'sakura',n:'Sakura Kristal',e:'🌸',r:'cool',c:2000,t:150,s:5000},
{id:'naga',n:'Buah Naga Emas',e:'🐉',r:'secret',c:6000,t:240,s:18000}];
const LIM={common:6,rare:3,cool:2,secret:1},CH={common:1,rare:.8,cool:.5,secret:.3},RN={common:'COMMON',rare:'RARE',cool:'COOL',secret:'SECRET'};
const RESTOCK=120000,KEY='growagarden_v2',$=i=>document.getElementById(i),byId=id=>P.find(p=>p.id===id),fmt=n=>n.toLocaleString('id-ID');
let S=null;try{S=JSON.parse(localStorage.getItem(KEY))}catch(e){}
if(!S||!S.plants){let o=null;try{o=JSON.parse(localStorage.getItem('growagarden_v1'))}catch(e){}
S={coins:100,seeds:{wortel:2},crops:{},plants:[],stock:{},next:0,sel:'wortel'};
if(o&&o.seeds){Object.assign(S,{coins:o.coins,seeds:o.seeds,crops:o.crops||{},sel:o.sel});(o.plots||[]).forEach((q,i)=>q&&S.plants.push({u:'m'+i,id:q.id,at:q.at,x:(i%4-1.5)*1.85,z:((i/4|0)-.5)*1.85}))}}
const SEEN=S.seen||0;
if(S.water===undefined)Object.assign(S,{water:50,bu:0,lb:1,lt:1});
if(!S.mp){S.plants.forEach(q=>q.z-=1.5);S.mp=1}
S.plants.forEach(q=>{if(q.g===undefined)q.g=Math.max(0,((SEEN||Date.now())-q.at)/1000)});
const BU=[10,15,20,30,40,50],TK=[50,75,100,150,200,300],BC=[150,500,1500,4000,10000],TC=[200,600,1800,5000,12000],BED={hx:6,hz:4},POND={x:12,z:0,r:2.4},TANK={x:7.8,z:0},SPL=6;
const net={on:0,slot:0,dirty:1},N=6,RP=26,COL=[0xe84855,0x3a86ff,0x2fa84f,0xf2c14e,0xb36bff,0xff8fc0];
let NAME='';try{NAME=localStorage.getItem('ga_name')||''}catch(e){}
if(!NAME){try{NAME=prompt('Nama kamu? (maks 12 huruf)','Petani')||''}catch(e){}NAME=NAME.trim().slice(0,12)||'Petani';try{localStorage.setItem('ga_name',NAME)}catch(e){}}
const bcap=()=>BU[S.lb-1],tcap=()=>TK[S.lt-1];
function save(){S.seen=Date.now();try{localStorage.setItem(KEY,JSON.stringify(S))}catch(e){}}
let tt;function toast(m){const t=$('toast');t.textContent=m;t.classList.add('on');clearTimeout(tt);tt=setTimeout(()=>t.classList.remove('on'),2000)}
function restock(){S.stock={};P.forEach(p=>{S.stock[p.id]=Math.random()<CH[p.r]?LIM[p.r]:-1});S.next=Date.now()+RESTOCK;save();if(!$('shopm').hidden)renderShop()}
function stk(m,nw){if(m.c!==S.cyc){S.cyc=m.c;S.stock=m.stock;if(nw)toast('Toko restock! 🎉')}S.next=Date.now()+m.in;save();if(!$('shopm').hidden)renderShop()}
function renderShop(){$('shop').innerHTML=P.map(p=>{const st=S.stock[p.id],ok=st>0&&S.coins>=p.c;
const info=st<0?'Tidak muncul kali ini':st===0?'Batas beli tercapai':`Batas beli: sisa ${st}/${LIM[p.r]}`;
return `<div class="card ${p.r}"><span class="tag">${RN[p.r]}</span><div class="emo">${p.e}</div><b>${p.n}</b><small>🪙 ${fmt(p.c)} · tumbuh ${p.t}d<br>jual ${fmt(p.s)}</small><small>${info}</small>
<button class="btn" data-buy="${p.id}" ${ok?'':'disabled'}>${st<0?'Kosong':st===0?'Habis':'Beli'}</button></div>`}).join('')}
function renderSell(){const ks=Object.keys(S.crops).filter(k=>S.crops[k]>0);let t=0;
const rows=ks.map(k=>{const p=byId(k);t+=p.s*S.crops[k];return `<span class="chip">${p.e} ${p.n} ×${S.crops[k]}</span>`}).join('');
$('crops').innerHTML=ks.length?`<div class="rows">${rows}</div><button class="btn sell" data-sell>Jual semua · 🪙 ${fmt(t)}</button>`:'<p>Belum ada hasil panen. Tanam bibit, tunggu matang, lalu panen.</p>'}
function renderBag(){const ids=Object.keys(S.seeds).filter(k=>S.seeds[k]>0);if(!ids.includes(S.sel))S.sel=ids[0]||null;
$('bag').innerHTML=ids.length?ids.map((k,i)=>`<button class="chip ${S.sel===k?'sel':''}" data-sel="${k}" title="${byId(k).n}"><small>${i+1}</small>${byId(k).e} ×${S.seeds[k]}</button>`).join(''):'<span class="chip">Tas kosong · beli bibit di toko 🏪</span>';
$('cn').textContent=Object.values(S.crops).reduce((a,b)=>a+b,0);$('coins').textContent=fmt(S.coins)}
function renderUpg(){const r=(k,ic,nm,lv,arr,cost)=>{const mx=lv>=arr.length;return `<div class="card common" style="margin-bottom:12px"><span class="tag">LV ${lv}</span><div class="emo">${ic}</div><b>${nm}</b><small>Kapasitas: ${arr[lv-1]} L${mx?'':' → '+arr[lv]+' L'}</small><button class="btn" data-up="${k}" ${mx||S.coins<cost[lv-1]?'disabled':''}>${mx?'MAX':'Upgrade · 🪙 '+fmt(cost[lv-1])}</button></div>`};
$('upg').innerHTML=r('bu','🪣','Ember',S.lb,BU,BC)+r('tk','🛢️','Tangki Air Kebun',S.lt,TK,TC)}
function openM(id){closeM();$(id).hidden=false;renderShop();renderSell();renderUpg()}
function closeM(){['shopm','sellm','upm'].forEach(i=>$(i).hidden=true)}
const modalOpen=()=>['shopm','sellm','upm'].some(i=>!$(i).hidden);
document.addEventListener('click',e=>{
if(e.target.classList&&e.target.classList.contains('modal')){closeM();return}
const b=e.target.closest('[data-buy],[data-sel],[data-sell],[data-close],[data-up]');if(!b)return;
if(b.dataset.close!==undefined){closeM();return}
if(b.dataset.buy){const p=byId(b.dataset.buy);if(S.stock[p.id]>0&&S.coins>=p.c){S.coins-=p.c;S.stock[p.id]--;S.seeds[p.id]=(S.seeds[p.id]||0)+1;if(!S.sel)S.sel=p.id;toast(`Dibeli: ${p.e} ${p.n}`)}}
else if(b.dataset.up){const bu=b.dataset.up==='bu',lv=bu?S.lb:S.lt,arr=bu?BU:TK,c=(bu?BC:TC)[lv-1];if(lv<arr.length&&S.coins>=c){S.coins-=c;if(bu)S.lb++;else S.lt++;toast('Upgrade berhasil! 🎉')}}
else if(b.dataset.sel){S.sel=b.dataset.sel}
else if(b.dataset.sell!==undefined){let t=0;Object.keys(S.crops).forEach(k=>t+=byId(k).s*S.crops[k]);S.crops={};S.coins+=t;toast(`Terjual! +🪙 ${fmt(t)}`)}
save();renderBag();if(!$('shopm').hidden)renderShop();if(!$('sellm').hidden)renderSell();if(!$('upm').hidden)renderUpg();hudWater()});
let lastT=SEEN||Date.now(),dry=false;
const fm=s=>Math.floor(s/60)+':'+String(Math.floor(s%60)).padStart(2,'0');
function advance(dt){while(dt>1e-6&&S.water>0){const gr=S.plants.filter(q=>q.g<byId(q.id).t);if(!gr.length)break;
const st=Math.min(dt,S.water*SPL,...gr.map(q=>byId(q.id).t-q.g));gr.forEach(q=>{q.g+=st;if(byId(q.id).t-q.g<1e-6)q.g=byId(q.id).t});S.water=Math.max(0,S.water-st/SPL);dt-=st}
if(S.water<=0&&S.plants.some(q=>q.g<byId(q.id).t)){if(!dry){dry=true;toast('Air kebun habis! Timba air di kolam 💧')}}else dry=false}
function step(){const n=Date.now();advance((n-lastT)/1000);lastT=n}
function hudWater(){const w=S.water,c=tcap();$('wt').textContent=`${w.toFixed(1)}/${c} L · ${fm(w*SPL)}`;$('wp').classList.toggle('low',w<c*.15);$('bk').textContent=`${S.bu}/${bcap()} L`}
function tick(){const now=Date.now();if(now>=S.next&&!net.on){restock();toast('Toko restock! 🎉')}
const left=Math.max(0,S.next-now),s=Math.ceil(left/1000),tx=Math.floor(s/60)+':'+String(s%60).padStart(2,'0');
$('rt').textContent=tx;$('rt2').textContent=tx;$('rb').style.width=(100-left/RESTOCK*100)+'%';hudWater()}
if(Date.now()>=S.next||!Object.keys(S.stock).length)restock();
renderBag();tick();setInterval(tick,250);setInterval(save,5000);addEventListener('pagehide',save);
const rp0=S.plants.filter(q=>q.g>=byId(q.id).t).length;step();setInterval(step,250);
const gone=S.plants.filter(q=>q.g>=byId(q.id).t).length-rp0;
if(SEEN&&gone)setTimeout(()=>toast(`Selamat datang kembali! ${gone} tanaman matang saat kamu pergi 🌟`),700);
setTimeout(()=>$('hint').classList.add('off'),10000);
(function(){try{
const cv=$('cv'),R=new THREE.WebGLRenderer({canvas:cv,antialias:true,alpha:true});R.setPixelRatio(Math.min(devicePixelRatio,2));
const sc=new THREE.Scene(),cam=new THREE.PerspectiveCamera(50,1,.1,220),RM=matchMedia('(prefers-reduced-motion:reduce)').matches;
sc.add(new THREE.HemisphereLight(0xffffff,0x8a9a6a,.95));const sun=new THREE.DirectionalLight(0xffffff,.8);sun.position.set(6,12,8);sc.add(sun);
const OUT=new THREE.MeshBasicMaterial({color:0x3b2a1a,side:THREE.BackSide}),GR=0x4fc23a;
const G={s:new THREE.SphereGeometry(1,18,14),c:new THREE.ConeGeometry(1,2,14),y:new THREE.CylinderGeometry(1,1,2,16),i:new THREE.IcosahedronGeometry(1,0),b:new THREE.BoxGeometry(2,2,2)};
const part=(g,k,col,x,y,z,sx,sy,sz,em)=>{const m=new THREE.Mesh(G[k],new THREE.MeshToonMaterial({color:col,emissive:em||0}));m.position.set(x,y,z);m.scale.set(sx,sy,sz);const o=new THREE.Mesh(G[k],OUT);o.scale.setScalar(1.09);m.add(o);g.add(m);return m};
const leaf=(g,y,s)=>[0,2.1,4.2].forEach(a=>{const m=part(g,'c',GR,Math.sin(a)*.12*s,y,Math.cos(a)*.12*s,.07*s,.3*s,.07*s);m.rotation.set(Math.cos(a)*.7,0,-Math.sin(a)*.7)});
const F={
wortel:g=>{part(g,'c',0xff8a1f,0,.2,0,.17,.4,.17).rotation.x=Math.PI;leaf(g,.6,1.3)},
stroberi:g=>{part(g,'s',0xff3b5c,0,.3,0,.27,.3,.27);part(g,'c',GR,0,.62,0,.12,.1,.12);leaf(g,.15,1)},
tomat:g=>{part(g,'s',0xff4a3a,0,.32,0,.33,.3,.33);part(g,'c',GR,0,.64,0,.14,.08,.14);leaf(g,.15,1)},
jagung:g=>{part(g,'y',0xffd83a,0,.5,0,.15,.5,.15);part(g,'c',GR,-.2,.35,0,.07,.4,.07).rotation.z=.5;part(g,'c',GR,.2,.35,0,.07,.4,.07).rotation.z=-.5},
bawang:g=>{part(g,'s',0xe9c6ff,0,.28,0,.3,.27,.3);part(g,'c',0xe9c6ff,0,.62,0,.1,.18,.1);leaf(g,.25,1)},
semangka:g=>{part(g,'s',0x2fa84f,0,.4,0,.52,.4,.4);part(g,'y',0x6a8f2a,0,.8,0,.05,.08,.05)},
labu:g=>{part(g,'s',0xff8a1f,0,.33,0,.46,.33,.46);part(g,'y',0x5a8a2a,0,.7,0,.06,.1,.06)},
jamur:g=>{part(g,'y',0xfff3e0,0,.28,0,.12,.3,.12);part(g,'s',0xb36bff,0,.62,0,.42,.28,.42,0x4a1f8a);part(g,'s',0xffffff,.2,.82,.1,.07,.05,.07);part(g,'s',0xffffff,-.15,.8,-.2,.07,.05,.07)},
sakura:g=>{part(g,'y',0x8a5a2b,0,.45,0,.09,.45,.09);[[0,1,0,.38],[.3,.8,.1,.28],[-.28,.85,-.1,.3]].forEach(([x,y,z,r])=>part(g,'s',0xff9ed0,x,y,z,r,r,r,0x5a1f40))},
naga:g=>{part(g,'i',0xff4fa0,0,.42,0,.4,.4,.4,0x801f50);[[.4,.4,0],[-.4,.4,0],[0,.4,.4],[0,.4,-.4]].forEach(([x,y,z])=>part(g,'c',0xffc928,x,y,z,.1,.22,.1,0x805a00))}};
function person(shirt,hat){const g=new THREE.Group(),b=new THREE.Group();g.add(b);
const sh=part(b,'y',shirt,0,.85,0,.3,.35,.22);part(b,'s',0xffd5a8,0,1.5,0,.3,.3,.3);
part(b,'s',0x222222,-.1,1.55,.27,.04,.05,.04);part(b,'s',0x222222,.1,1.55,.27,.04,.05,.04);
part(b,'y',hat,0,1.78,0,.46,.04,.46);part(b,'y',hat,0,1.9,0,.24,.12,.24);
const lim=(x,y,c,w,h)=>{const q=new THREE.Group();q.position.set(x,y,0);part(q,'b',c,0,-h,0,w,h,w);b.add(q);return q};
